{
  "name": "landing-page-emr-internacional-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:prod": "dotenv -e .env.production -- playwright test",
    "test:e2e:prod:ui": "dotenv -e .env.production -- playwright test --ui",
    "test:seo": "playwright test tests/seo --reporter=html",
    "test:seo:prod": "dotenv -e .env.production -- playwright test tests/seo --reporter=html",
    "test:seo:metadata": "playwright test tests/seo/metadata.spec.ts",
    "test:seo:semantic": "playwright test tests/seo/semantic-html.spec.ts",
    "test:seo:a11y": "playwright test tests/seo/accessibility.spec.ts",
    "test:seo:performance": "playwright test tests/seo/performance-keywords.spec.ts",
    "test:all": "npm run test:run && npm run test:e2e",
    "test:all:prod": "npm run test:run && npm run test:e2e:prod",
    "pre-deploy": "bash scripts/pre-deploy-validation.sh"
  },
  "dependencies": {
    "@sentry/react": "^10.26.0",
    "lucide-react": "^0.556.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-focus-lock": "^2.13.7",
    "web-vitals": "^5.1.0",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@sentry/vite-plugin": "^4.6.1",
    "@storybook/react-vite": "^10.0.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.0.12",
    "@vitest/ui": "^4.0.12",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.11.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-loops": "^0.4.0",
    "eslint-plugin-playwright": "^2.4.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "rollup-plugin-copy": "^3.5.0",
    "sharp": "^0.34.5",
    "storybook": "^10.0.8",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.2.2",
    "vite": "^7.2.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.0.12",
    "wait-on": "^8.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
