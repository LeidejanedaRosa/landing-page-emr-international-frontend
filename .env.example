# Playwright Testing Configuration
# Copy this file to .env and update with your actual values

# Base URL for Playwright tests (optional)
# Leave empty to test against local dev server (http://localhost:3000)
# Set to your production URL to test against deployed site
PLAYWRIGHT_BASE_URL=

# Example for production testing:
# PLAYWRIGHT_BASE_URL=https://landing-page-emr-international.vercel.app

# Sentry Configuration (Error Monitoring & Performance)
# Get your DSN from: https://sentry.io/settings/[your-org]/projects/[your-project]/keys/
# Only required for production builds
# Example: VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
VITE_SENTRY_DSN=

# Sentry Auth Token for Source Maps Upload (CI/CD only)
# Get from: https://sentry.io/settings/account/api/auth-tokens/
# Required permissions: project:releases, project:write
SENTRY_AUTH_TOKEN=

# Sentry Organization Slug
# Find at: https://sentry.io/settings/
SENTRY_ORG=

# Sentry Project Name
# The name you gave your project when creating it
SENTRY_PROJECT=
