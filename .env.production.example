# Production Testing Configuration
# Copy this file to .env.production and update with your actual deployment URL

# Base URL for Playwright tests against production deployment
# Example: PLAYWRIGHT_BASE_URL=https://your-app.vercel.app
PLAYWRIGHT_BASE_URL=

# Sentry Configuration (REQUIRED for production)
# Get your DSN from: https://sentry.io/settings/[your-org]/projects/[your-project]/keys/
# Example: VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
VITE_SENTRY_DSN=

# Sentry Auth Token for Source Maps Upload (CI/CD)
# Get from: https://sentry.io/settings/account/api/auth-tokens/
# Required permissions: project:releases, project:write
SENTRY_AUTH_TOKEN=

# Sentry Organization Slug (required for source maps)
SENTRY_ORG=

# Sentry Project Name (required for source maps)
SENTRY_PROJECT=
